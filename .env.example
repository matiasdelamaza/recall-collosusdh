# ─────────────────────────────────────────────────────────────
# recallcollosusdh.cl — variables de entorno
# Copia este archivo a .env y completa los valores.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (canonical, enlaces en emails)
NEXT_PUBLIC_SITE_URL=https://recallcollosusdh.cl

# Base de datos.
# Producción: PostgreSQL / Supabase (cadena de conexión completa).
# Desarrollo: deja vacío y se usa PGlite (archivo local en ./.data/pglite).
DATABASE_URL=

# Secreto para firmar cookies de sesión del panel interno (mín. 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Contraseña de acceso al panel interno (/admin). Define una fuerte y rótala periódicamente.
ADMIN_PASSWORD=

# Sal para hashear IPs en registros de auditoría (no se guardan IPs en claro).
IP_HASH_SALT=

# Correo transaccional.
# EMAIL_PROVIDER = console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Recall Polygon Collosus DH <no-reply@recallcollosusdh.cl>"
# Destinatarios internos de Postventa (separados por coma). [POR DEFINIR por Cross Mountain]
INTERNAL_NOTIFICATION_EMAILS=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Almacenamiento de archivos subidos.
# STORAGE_PROVIDER = local | s3   (s3 sirve para AWS S3, Cloudflare R2, Supabase Storage S3-compatible)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.data/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Cloudflare Turnstile (opcional, anti-enumeración). Si se define, se exige tras actividad sospechosa.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Datos de contacto públicos. NO inventar: dejar vacíos hasta que Cross Mountain los defina.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_HOURS=

# Analítica (sin PII). ANALYTICS_PROVIDER = internal | none
ANALYTICS_PROVIDER=internal

# Si el sitio está en staging, evita indexación.
NEXT_PUBLIC_NOINDEX=false

# ─────────────────────────────────────────────────────────────
# recallcollosusdh.cl — variables de entorno
# Copia este archivo a .env y completa los valores.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (canonical, enlaces en emails)
NEXT_PUBLIC_SITE_URL=https://recallcollosusdh.cl

# Base de datos.
# Producción: PostgreSQL / Supabase (cadena de conexión completa).
# Con la integración Supabase-Vercel puedes dejarla vacía: se usan POSTGRES_URL (app) y POSTGRES_URL_NON_POOLING (migraciones).
# Desarrollo: deja vacío y se usa PGlite (archivo local en ./.data/pglite).
DATABASE_URL=
# TLS hacia la base de datos: vacío/false (sin TLS), true (TLS con verificación de certificado),
# no-verify (TLS sin verificar; solo si el proveedor no entrega CA). Opcional: DATABASE_SSL_CA con el PEM de la CA.
DATABASE_SSL=
DATABASE_SSL_CA=

# Proxy de confianza del que se toma la IP del cliente (límites de tasa y auditoría):
#   standard  → último elemento de X-Forwarded-For (Vercel, Caddy, balanceadores)   [por defecto]
#   cloudflare → cabecera cf-connecting-ip (solo si todo el tráfico pasa por Cloudflare)
#   nginx     → cabecera X-Real-IP (nginx con proxy_set_header X-Real-IP $remote_addr)
# El sitio SIEMPRE debe publicarse detrás de un proxy/CDN; nunca exponer el puerto 3000 directamente.
TRUSTED_PROXY=standard

# Secreto para firmar cookies de sesión del panel interno (mín. 32 caracteres aleatorios).
# Genera uno con: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Contraseña de acceso al panel interno (/admin). Define una fuerte y rótala periódicamente.
ADMIN_PASSWORD=

# Sal para hashear IPs en registros de auditoría (no se guardan IPs en claro).
IP_HASH_SALT=

# Correo transaccional.
# EMAIL_PROVIDER = console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Polygon Collosus DH · Cross Mountain <no-reply@recallcollosusdh.cl>"
# Destinatarios internos de Postventa (separados por coma). [POR DEFINIR por Cross Mountain]
INTERNAL_NOTIFICATION_EMAILS=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Almacenamiento de archivos subidos.
# STORAGE_PROVIDER = local | vercel-blob | supabase | s3
#   vercel-blob → Vercel Blob privado enlazado al proyecto (Vercel inyecta BLOB_READ_WRITE_TOKEN; sin configuración extra)
#   supabase → Supabase Storage por API REST (recomendado con Supabase; usa SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY,
#              que la integración Supabase-Vercel inyecta automáticamente; el bucket privado se crea solo)
#   s3       → AWS S3, Cloudflare R2 o Supabase Storage S3-compatible con claves S3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recall-files
VERCEL_BLOB_PREFIX=recall
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Cloudflare Turnstile (opcional, anti-enumeración). Si se define, se exige tras actividad sospechosa.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Datos de contacto públicos. NO inventar: dejar vacíos hasta que Cross Mountain los defina.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_HOURS=

# Agente de MABA (chat flotante del sitio público). Vacío = no se muestra.
# Id de comercio que entrega MABA (va como data-merchant en https://www.trymaba.com/widget.js).
NEXT_PUBLIC_MABA_MERCHANT_ID=
# Clave secreta con que el agente de MABA consulta series en POST /api/maba/serie
# ("Authorization: Bearer …"). Mín. 32 caracteres; genera una con: openssl rand -hex 32
MABA_API_KEY=

# Analítica (sin PII). ANALYTICS_PROVIDER = internal | none
ANALYTICS_PROVIDER=internal

# Si el sitio está en staging, evita indexación.
NEXT_PUBLIC_NOINDEX=false

# Fecha de "Última actualización" mostrada en el pie de página (ISO, ej. 2026-10-27). Si se omite, se usa la fecha de arranque.
NEXT_PUBLIC_LAST_UPDATED=
